# Anthropic Claude API キー（必須）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your-api-key-here

# 使用するモデル（省略可）
# 既定: claude-3-5-haiku-20241022
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# 国会 API ベース URL（省略可）
# KOKKAI_API_BASE_URL=https://kokkai.ndl.go.jp/api

# タイムアウト (ms)（省略可）
# REQUEST_TIMEOUT_MS=30000

# リトライ上限（省略可）
# MAX_RETRIES=2

# キャッシュ TTL（秒）（省略可）
# CACHE_SPEECH_TTL_SEC=86400
# CACHE_MEETING_TTL_SEC=604800
# CACHE_SUMMARY_TTL_SEC=604800

# 要約対象発言数の上限（省略可）
# MAX_SUMMARIZE_ITEMS=200

# 並列リクエスト上限（省略可）
# MAX_CONCURRENT_REQUESTS=3
